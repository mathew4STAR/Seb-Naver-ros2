<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>seb_naver_bringup</name>
  <version>0.1.0</version>
  <description>Bringup package for seb_naver integrating Gazebo, terrain_analyzer, and Nav2.</description>
  <maintainer email="user@todo.todo">User</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>se2_grid_core</depend>
  <depend>se2_grid_ros</depend>
  <depend>se2_grid_msgs</depend>

  <exec_depend>seb_naver_simulation</exec_depend>
  <exec_depend>terrain_analyzer</exec_depend>
  <exec_depend>se2_traversability_critic</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
